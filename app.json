{
  "configVersion": "v3",
  "app": {
    "appId": 1129461,
    "appName": "Golf Tracker",
    "appType": "app",
    "version": {
      "code": 4,
      "name": "2.0.0"
    },
    "icon": "icon.png",
    "vender": "Chris",
    "description": "Front, middle and back green distances"
  },
  "permissions": [
    "device:os.geolocation",
    "device:os.local_storage"
  ],
  "runtime": {
    "apiVersion": {
      "compatible": "3.0.0",
      "target": "3.0.0",
      "minVersion": "3.0"
    }
  },
  "targets": {
    "default": {
      "module": {
        "page": {
          "pages": [
            "page/home",
            "page/hole",
            "page/courses"
          ]
        },
        "app-side": {
          "path": "app-side/index"
        },
        "setting": {
          "path": "setting/index"
        }
      },
      "platforms": [
        {
          "st": "r",
          "dw": 480
        }
      ]
    }
  },
  "i18n": {
    "en-US": {
      "appName": "Golf Tracker"
    }
  },
  "defaultLanguage": "en-US"
}
